{
    "layer": "top",
    "position": "bottom",
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "tray",
        "memory",
        "wireplumber",
        "battery",
    ],
    "hyprland/workspaces": {
        "on-click": "activate",
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false,
    },
    "memory": {
        "interval": 3,
        "format": "M {used}",
        "tooltip": false,
    },
    "tray": {
        "spacing": 7,
    },
    "wireplumber": {
        "format": "V {volume}",
        "scroll-step": 1,
        "tooltip": false,
    },
    "battery": {
        "format": "B {capacity}",
        "interval": 3,
        "states": {
            "warning": 30,
            "critical": 10,
        },
        "tooltip": false,
    },
}
